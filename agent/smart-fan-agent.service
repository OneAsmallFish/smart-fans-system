[Unit]
Description=Smart Fan Agent — Server Fan Controller Bridge
After=network.target multi-user.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nobody
# AG-05: 串口设备（/dev/ttyACM0）通常归 dialout 组
SupplementaryGroups=dialout
ExecStart=/usr/local/bin/smart-fan-agent
Environment=SMART_FAN_CONFIG=/etc/smart-fan-agent/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
