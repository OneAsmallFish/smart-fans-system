# Go build artifacts
agent/build/
agent/vendor/
agent/*.exe
agent/smart-fan-agent

# Node.js
web/node_modules/
web/frontend/node_modules/
web/backend/node_modules/
web/frontend/dist/
web/backend/dist/
web/.env
web/frontend/.env
web/backend/.env

# Python
__pycache__/
*.pyc
.venv/

# KiCad artifacts
hardware/**/__pycache__/
hardware/**/*.bak
hardware/**/*-backups/
hardware/**/*.000
hardware/gerber/*.zip
hardware/**/*.dsn
hardware/**/*.ses

# Secrets / credentials (never commit)
*.pem
*.key
*.crt
config.local.yaml
agent/config.local.yaml
**/secrets.yaml

# Editor / OS
.vscode/settings.json
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Test evidence (optional, keep for CI)
# .sisyphus/evidence/

# AI 过程产物（DOC-05: 字节级过程产物，移出 git 跟踪）
.omo/
.sisyphus/
.claude/

# 硬件备份文件（H-15: 根目录及其它目录通用，hardware/ 子目录规则见上）
*.bak
*.v7backup

# Logs
*.log
logs/
