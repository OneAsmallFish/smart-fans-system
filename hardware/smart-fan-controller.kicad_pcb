(kicad_pcb
  (version 20221018)
  (generator pcbnew)
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
    (49 "User.1" user)
  )
  (setup
    (pad_to_mask_clearance 0.051)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros no)
      (usegerberextensions no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (creategerberjobfile yes)
      (dashed_line_dash_ratio 12.0)
      (dashed_line_gap_ratio 3.0)
      (svguseinch no)
      (svgprecision 4)
      (excludeedgelayer yes)
      (plotframeref no)
      (viasonmask no)
      (mode 1)
      (useauxorigin no)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.0)
      (dxfpolygonmode yes)
      (dxfimperialunits yes)
      (dxfusepcbnewfont yes)
      (psnegative no)
      (psa4output no)
      (plotreference yes)
      (plotvalue yes)
      (plotinvisibletext no)
      (sketchpadsonfab no)
      (subtractmaskfrompaste no)
      (outputformat 1)
      (mirror no)
      (drillshape 1)
      (scaleselection 1)
      (outputdirectory "gerber/")
    )
  )

  (gr_rect
    (start 0 0) (end 80 60)
    (stroke (width 0.05) (type solid))
    (layer "Edge.Cuts")
  )

  (footprint "ESP32-S3-WROOM-1" (layer "F.Cu")
    (at 35 25 0)
    (descr "ESP32-S3-WROOM-1-N16R8, WiFi+BLE module")
    (fp_text reference "U2" (at 0 -14) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "ESP32-S3-WROOM-1-N16R8" (at 0 14) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -9 -12.75) (end 9 12.75) (layer "F.Fab") (stroke (width 0.1) (type solid)))
    (fp_text user "ANTENNA →" (at 6 0 0) (layer "F.SilkS")
      (effects (font (size 0.8 0.8) (thickness 0.12)))
    )
  )

  (zone
    (net 0) (net_name "")
    (layer "F.Cu")
    (name "ANTENNA_KEEPOUT_15mm")
    (hatch edge 0.5)
    (connect_pads (clearance 0))
    (min_thickness 0.25)
    (keepout_constraints
      (kcq_tracks no) (kcq_vias no) (kcq_copperpour no)
      (kcq_footprints no) (kcq_text no)
    )
    (polygon
